---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style is:global>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      background: linear-gradient(135deg, #0f172a 0%, #0c0c1f 70%, #070707 100%);
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .pulse-animation {
      animation: pulse 2s ease-in-out infinite;
    }

    .slide-in {
      animation: slideIn 0.8s ease-out;
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(8px);
    }

    .clock-face {
      background: radial-gradient(circle at center, #0f172a 0%, #111827 70%);
      box-shadow:
        inset 0 0 50px rgba(0,0,0,0.8),
        0 0 30px rgba(0,0,0,0.3);
    }

    .tick-mark {
      background: linear-gradient(to bottom, #9ca3af 0%, #6b7280 100%);
      box-shadow: 0 0 1px rgba(255,255,255,0.1);
    }

    .hour-mark {
      background: linear-gradient(to bottom, #f97316 0%, #ea580c 100%);
      box-shadow: 0 0 2px rgba(249,115,22,0.3);
    }

    .weather-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
      backdrop-filter: blur(15px);
    }
  </style>
</head>
<body class="text-white min-h-screen max-h-screen overflow-hidden">
  <slot />
</body>
</html>
