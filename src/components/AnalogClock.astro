---
// アナログ時計コンポーネント
---

<div class="w-1/2 flex flex-col p-6 pr-2">
  <div class="h-full flex items-center justify-center relative">
    <div id="clock-container" class="clock-face relative rounded-full flex items-center justify-center slide-in">
      <div id="clock-ticks" class="absolute w-full h-full rounded-full"></div>

      <div id="second-hand" class="absolute w-0.5 h-36 bg-red-500 rounded-full origin-bottom" style="top: 50%; left: 50%; transform: translate(-50%, -100%);"></div>

      <div id="digital-clock" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-light px-4 rounded-xl z-20" style="backdrop-filter: blur(2px); line-height: 1;">00:00</div>
    </div>
  </div>

  <div class="h-24 flex flex-col items-center justify-end space-y-4 slide-in pb-6">
    <div class="text-center">
      <div id="date-display" class="text-4xl font-light mb-3 opacity-80" style="font-size: 2rem; line-height: 1.2;"></div>
      <div class="relative mx-auto w-72">
        <div class="absolute -top-4 left-0 w-full h-6 opacity-25 blur-lg overflow-hidden" style="background: radial-gradient(ellipse 80% 200% at center bottom, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.3) 30%, transparent 50%);"></div>
        <div class="w-full h-px" style="background: linear-gradient(to bottom, #6b7280 0%, #4b5563 100%);"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // 時計のサイズを動的に設定する関数
  function setClockSize() {
    const clockContainer = document.getElementById('clock-container');
    if (!clockContainer) return 0;

    const leftPanel = clockContainer.parentElement?.parentElement;
    if (!leftPanel) return 0;

    const computedStyle = window.getComputedStyle(leftPanel);
    const paddingLeft = parseFloat(computedStyle.paddingLeft);
    const paddingRight = parseFloat(computedStyle.paddingRight);
    const paddingTop = parseFloat(computedStyle.paddingTop);
    const paddingBottom = parseFloat(computedStyle.paddingBottom);

    const dateArea = leftPanel.querySelector('.h-24') as HTMLElement | null;
    const dateAreaHeight = dateArea ? dateArea.offsetHeight : 0;

    const availableWidth = leftPanel.clientWidth - paddingLeft - paddingRight;
    const additionalMargin = leftPanel.clientHeight * 0.05;
    const availableHeight = leftPanel.clientHeight - paddingTop - paddingBottom - dateAreaHeight - additionalMargin;

    const maxSize = Math.min(availableWidth, availableHeight);
    const clockSize = Math.max(200, Math.min(maxSize, 500));

    clockContainer.style.width = clockSize + 'px';
    clockContainer.style.height = clockSize + 'px';

    const secondHand = document.getElementById('second-hand');
    if (secondHand) {
      const handLength = clockSize * 0.38;
      secondHand.style.height = handLength + 'px';
    }

    const digitalClock = document.getElementById('digital-clock');
    if (digitalClock) {
      const fontSize = clockSize * 0.26;
      digitalClock.style.fontSize = fontSize + 'px';
    }

    return clockSize;
  }

  // 時計の目盛り生成
  function createClockTicks() {
    const ticksContainer = document.getElementById('clock-ticks');
    if (!ticksContainer) return;

    const clockSize = setClockSize();
    const radius = clockSize / 2;

    ticksContainer.innerHTML = '';

    for (let i = 0; i < 12; i++) {
      const isQuarterHour = i % 3 === 0;

      const tick = document.createElement('div');
      tick.className = `absolute rounded-full tick-mark ${isQuarterHour ? 'hour-mark' : ''}`;

      const tickScale = clockSize / 384;

      if (isQuarterHour) {
        tick.style.width = Math.max(2, 2 * tickScale) + 'px';
        tick.style.height = Math.max(12, 18 * tickScale) + 'px';
      } else {
        tick.style.width = Math.max(1, 1 * tickScale) + 'px';
        tick.style.height = Math.max(8, 10 * tickScale) + 'px';
        tick.style.background = 'linear-gradient(to bottom, #9ca3af 0%, #6b7280 100%)';
        tick.style.opacity = '0.7';
      }

      tick.style.top = '50%';
      tick.style.left = '50%';
      const tickOffset = Math.max(10, 15 * tickScale);
      tick.style.transform = `translate(-50%, -${radius - tickOffset}px) rotate(${i * 30}deg)`;
      tick.style.transformOrigin = `center ${radius - tickOffset}px`;

      ticksContainer.appendChild(tick);
    }
  }

  // 時刻更新関数
  function updateTime() {
    const now = new Date();
    const hours = now.getHours();
    const minutes = now.getMinutes();
    const seconds = now.getSeconds();

    const hoursStr = String(hours).padStart(2, '0');
    const minutesStr = String(minutes).padStart(2, '0');

    const digitalClock = document.getElementById('digital-clock');
    if (digitalClock) {
      digitalClock.textContent = `${hoursStr}:${minutesStr}`;
    }

    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    const days = ['Sun.', 'Mon.', 'Tue.', 'Wed.', 'Thu.', 'Fri.', 'Sat.'];
    const dayName = days[now.getDay()];

    let dayColor = 'inherit';
    if (dayName === 'Sat.') {
      dayColor = '#3b82f6';
    } else if (dayName === 'Sun.') {
      dayColor = '#dc2626';
    }

    const dateDisplay = document.getElementById('date-display');
    if (dateDisplay) {
      dateDisplay.innerHTML = `${year}<span style="font-size: 0.6em;"> </span>/<span style="font-size: 0.6em;"> </span>${month}<span style="font-size: 0.6em;"> </span>/<span style="font-size: 0.6em;"> </span>${day}<span style="font-size: 0.4em;"> </span><span style="color: #f97316; font-weight: 100; vertical-align: middle; font-size: 0.9em;">│</span><span style="font-size: 0.4em;"> </span><span style="color: ${dayColor};">${dayName}</span>`;
    }

    const secondHand = document.getElementById('second-hand');
    if (secondHand) {
      const secondDegrees = (seconds / 60) * 360;
      secondHand.style.transform = `translate(-50%, -100%) rotate(${secondDegrees}deg)`;
    }
  }

  // ウィンドウリサイズ時の処理
  function handleResize() {
    createClockTicks();
  }

  // 初期化
  document.addEventListener('DOMContentLoaded', () => {
    createClockTicks();
    updateTime();
    setInterval(updateTime, 1000);
    window.addEventListener('resize', handleResize);
  });
</script>
